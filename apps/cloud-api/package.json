{
  "name": "@comanview/cloud-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ComanView Cloud API — Fastify server with PostgreSQL, idempotent Sync Inbox, Cloud config distribution",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@comanview/config": "workspace:*",
    "@comanview/contracts": "workspace:*",
    "@comanview/domain": "workspace:*",
    "@comanview/money": "workspace:*",
    "@comanview/sync": "workspace:*",
    "@comanview/database": "workspace:*",
    "@comanview/auth": "workspace:*",
    "@comanview/licensing": "workspace:*",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@comanview/testing": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
