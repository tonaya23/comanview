{
  "name": "@comanview/storefront",
  "version": "0.0.0",
  "private": true,
  "description": "ComanView Storefront — Public-facing Next.js ordering site. Cloud-hosted only. MUST NOT connect directly to Edge.",
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@comanview/client-sdk": "workspace:*",
    "@comanview/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
