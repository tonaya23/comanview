{
  "name": "@comanview/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Database schema definitions and Drizzle config for Edge (SQLite) and Cloud (PostgreSQL)",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./edge": {
      "import": "./dist/edge/index.js",
      "types": "./dist/edge/index.d.ts"
    },
    "./cloud": {
      "import": "./dist/cloud/index.js",
      "types": "./dist/cloud/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:prepare": "tsx src/edge/prepareDevelopmentDatabase.ts",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@comanview/domain": "workspace:*",
    "@comanview/money": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  }
}
